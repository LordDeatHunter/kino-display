# TMDB credentials — https://www.themoviedb.org/settings/api
# API_READ_ACCESS_TOKEN is the v4 bearer token and is what the app uses.
# API_KEY is the v3 key, kept as a fallback if no bearer token is set.
API_READ_ACCESS_TOKEN=
API_KEY=

# Library locations, one setting per library. Relative paths resolve against the project
# root. Several folders are separated by the OS path separator (";" on Windows, ":"
# elsewhere). `python main.py` normally writes your choice to config.json, which wins
# over this file. Set them here to give the launcher a fallback when config.json has
# nothing for that library.
#MOVIES_DIRS=../Movies;D:/More Movies
#SERIES_DIRS=D:/Series

# Where the caches and overrides live. Relative to the project root.
DATA_DIR=data

# Server bind address for `python manage.py serve`
HOST=127.0.0.1
PORT=8000

# TMDB metadata language and how many requests to run in parallel
TMDB_LANGUAGE=en-US
MAX_CONCURRENCY=8
